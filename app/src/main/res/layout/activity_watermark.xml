<?xml version="1.0" encoding="utf-8"?>
<!-- 素材水印工具主界面 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:orientation="vertical">

    <!-- 顶部栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- 返回首页图标按钮（无文字） -->
        <ImageButton
            android:id="@+id/btn_back_home"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="-8dp"
            android:layout_marginEnd="8dp"
            android:background="@null"
            android:contentDescription="@string/wm_back_home"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_index"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 图片预览区域（固定 1:1 正方形，图片按真实比例居中，超出部分留黑边不显示）
         高度参与 weight 分配：空间不足时自动缩小，避免挤占下方可滚动区域 -->
    <com.huanghy7588.xiaqiaoqiaogongjvxiang.watermark.SquareLayout
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@color/black">

        <com.huanghy7588.xiaqiaoqiaogongjvxiang.watermark.WatermarkView
            android:id="@+id/watermark_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/btn_import_empty"
            style="@style/Widget.XiaQiaoQiao.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:minWidth="160dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/wm_import_images" />
    </com.huanghy7588.xiaqiaoqiaogongjvxiang.watermark.SquareLayout>

    <!-- 位置调整区（固定，置于预览正下方、文字输入框上方，方便调整水印位置） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 水印位置：居中 / 左下角 / 右下角 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wm_default_pos"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_position"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_pos_bottom_left"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/wm_pos_bottom_left" />

                <RadioButton
                    android:id="@+id/rb_pos_center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/wm_pos_center" />

                <RadioButton
                    android:id="@+id/rb_pos_bottom_right"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/wm_pos_bottom_right" />
            </RadioGroup>
        </LinearLayout>

        <!-- 位置调整：十字方向盘（上/左/右/下） -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/wm_fine_tune_pos"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:columnCount="3">

            <!-- 第一行：上 -->
            <Space
                android:layout_width="52dp"
                android:layout_height="52dp" />

            <Button
                android:id="@+id/btn_up"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="↑"
                android:textSize="20sp" />

            <Space
                android:layout_width="52dp"
                android:layout_height="52dp" />

            <!-- 第二行：左 / 中空 / 右 -->
            <Button
                android:id="@+id/btn_left"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="←"
                android:textSize="20sp" />

            <Space
                android:layout_width="52dp"
                android:layout_height="52dp" />

            <Button
                android:id="@+id/btn_right"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="→"
                android:textSize="20sp" />

            <!-- 第三行：下 -->
            <Space
                android:layout_width="52dp"
                android:layout_height="52dp" />

            <Button
                android:id="@+id/btn_down"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="↓"
                android:textSize="20sp" />

            <Space
                android:layout_width="52dp"
                android:layout_height="52dp" />
        </GridLayout>

        <!-- 字体大小 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/wm_font_size"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_bigger"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="A+" />

            <Button
                android:id="@+id/btn_smaller"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="A-" />
        </LinearLayout>
    </LinearLayout>

    <!-- 其余功能（可滚动） -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:background="@color/bg_card"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 文字输入（支持多行，回车换行） -->
            <EditText
                android:id="@+id/et_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="@string/wm_input_hint"
                android:inputType="textMultiLine"
                android:maxLines="3"
                android:minLines="1" />

            <!-- 字体提示 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/wm_font_hint"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- 描边 / 序号 开关 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_stroke"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/wm_stroke" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_numbering"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/wm_numbering" />
            </LinearLayout>

            <!-- 应用位置到所有图 / 重置 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_apply_all"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/wm_apply_to_all" />

                <Button
                    android:id="@+id/btn_reset"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/wm_reset_pos" />
            </LinearLayout>

            <!-- 上一张 / 下一张 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_prev"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/wm_prev" />

                <Button
                    android:id="@+id/btn_next"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/wm_next" />
            </LinearLayout>

            <!-- 预览提示：点击上方预览图可进入大图预览 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/wm_preview_hint"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- 清除导入的图片（与导入/导出同组，整行避免误触，点击有二次确认） -->
            <Button
                android:id="@+id/btn_clear_images"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/wm_clear_images"
                android:textColor="#C62828" />

            <!-- 导入 / 导出 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_import"
                    style="@style/Widget.XiaQiaoQiao.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/wm_import_images" />

                <Button
                    android:id="@+id/btn_export"
                    style="@style/Widget.XiaQiaoQiao.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/brand_accent"
                    android:text="@string/wm_export" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
