<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:orientation="vertical">

    <include layout="@layout/include_top_bar" />

    <com.huanghy7588.xiaqiaoqiaogongjvxiang.bead.BeadCropView
        android:id="@+id/crop_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg_page" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <Button
            android:id="@+id/btn_ratio_free"
            style="@style/Widget.XiaQiaoQiao.Button.Chip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/bead_ratio_free" />

        <Button
            android:id="@+id/btn_ratio_1"
            style="@style/Widget.XiaQiaoQiao.Button.Chip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/bead_ratio_1" />

        <Button
            android:id="@+id/btn_ratio_43"
            style="@style/Widget.XiaQiaoQiao.Button.Chip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/bead_ratio_43" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/btn_skip_crop"
            style="@style/Widget.XiaQiaoQiao.Button.DangerOutline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/bead_skip_crop" />

        <Button
            android:id="@+id/btn_crop_next"
            style="@style/Widget.XiaQiaoQiao.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/bead_next" />
    </LinearLayout>
</LinearLayout>
