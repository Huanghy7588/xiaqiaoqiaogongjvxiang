<?xml version="1.0" encoding="utf-8"?>
<!-- 贴膜水印机：文件夹命名 / 选择对话框 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_dialog_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tiemo_folder_name_hint"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/et_folder_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="@string/tiemo_folder_name_hint"
        android:inputType="text"
        android:minHeight="48dp"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tv_existing_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/tiemo_save_pick_hint"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <ScrollView
        android:id="@+id/scroll_existing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="200dp">

        <LinearLayout
            android:id="@+id/layout_existing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
