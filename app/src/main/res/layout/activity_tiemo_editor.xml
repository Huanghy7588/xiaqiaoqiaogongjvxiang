<?xml version="1.0" encoding="utf-8"?>
<!-- 贴膜水印机：编辑主页 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- 统一返回栏（含标题，文字代码中设置） -->
        <include layout="@layout/include_top_bar" />

        <!-- 顶部操作：清图（左，红色醒目） / 保存（右，绿色主操作） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp">

            <Button
                android:id="@+id/btn_clear_all"
                style="@style/Widget.XiaQiaoQiao.Button.Danger"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/tiemo_clear" />

            <View
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btn_save_top"
                style="@style/Widget.XiaQiaoQiao.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/tiemo_save" />
        </LinearLayout>

        <!-- 图片（必选，可多张） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_image_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/bg_section_accent"
                    android:drawablePadding="8dp"
                    android:text="@string/tiemo_image"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_image_add"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="@string/tiemo_add"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_image_clear"
                    style="@style/Widget.XiaQiaoQiao.Button.DangerOutline"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:text="@string/tiemo_clear"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 已导入图片网格（代码中动态填充） -->
            <GridLayout
                android:id="@+id/grid_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:columnCount="3"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_image_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/tiemo_need_base"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 叠加层卡片容器（代码中依次 inflate 水印 / 底纹 / 小水印） -->
        <FrameLayout
            android:id="@+id/container_layers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- 预览 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/bg_section_accent"
                android:drawablePadding="8dp"
                android:text="@string/tiemo_preview"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <com.huanghy7588.xiaqiaoqiaogongjvxiang.tiemo.TiemoPreviewView
                android:id="@+id/preview_view"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_preview_frame" />

            <Button
                android:id="@+id/btn_generate_all"
                style="@style/Widget.XiaQiaoQiao.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:text="@string/tiemo_generate_all" />
        </LinearLayout>

        <!-- 合成结果 + 保存全部（保存全部在结果正右方） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/bg_section_accent"
                android:drawablePadding="8dp"
                android:text="@string/tiemo_save_all"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layout_results"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <Button
                    android:id="@+id/btn_save_all"
                    style="@style/Widget.XiaQiaoQiao.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:text="@string/tiemo_save_all"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_result_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/tiemo_no_results"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
